generator client {
  provider = "prisma-client-js"
}

datasource db {
  url      = env("DATABASE_URL")
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  OWNER
  MANAGER
  KITCHEN
  WAITER
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING_PAYMENT
  NEW
  ACCEPTED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  SERVED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PayAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum CouponType {
  PERCENT
  FIXED
  BOGO
}

enum LoyaltyReason {
  EARN
  REDEEM
  REFERRAL
  ADJUST
}

enum ReferralStatus {
  PENDING
  REWARDED
}

enum CampaignChannel {
  EMAIL
  WHATSAPP
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
}

enum MessageStatus {
  QUEUED
  SENT
  FAILED
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
  NO_SHOW
  COMPLETED
}

model Tenant {
  id          String       @id @default(cuid())
  name        String
  status      TenantStatus @default(ACTIVE)
  plan        String       @default("STARTER")
  maxOutlets  Int          @default(1)
  createdAt   DateTime     @default(now())
  users       User[]
  restaurants Restaurant[]
  subscription Subscription?
  invoices    Invoice[]
}

model User {
  id            String         @id @default(cuid())
  tenantId      String?
  email         String         @unique
  passwordHash  String
  name          String
  role          Role
  restaurantId  String?
  failedLogins  Int            @default(0)
  lockedUntil   DateTime?
  emailVerifiedAt DateTime?
  tokensValidAfter DateTime?
  mfaEnabled    Boolean        @default(false)
  mfaSecretEnc  String?
  mfaPendingEnc String?
  mfaLastStep   Int?
  recoveryCodes String[]       @default([])
  authTokens    AuthToken[]
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
  refreshTokens RefreshToken[]

  @@index([tenantId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  restaurantId String?
  expiresAt DateTime
  revokedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Restaurant {
  id                String   @id @default(cuid())
  tenantId          String
  slug              String   @unique
  name              String
  description       String   @default("")
  category          String   @default("Restaurant")
  address           String   @default("")
  phone             String   @default("")
  whatsapp          String   @default("")
  currency          String   @default("INR")
  taxPercent        Decimal  @default(5) @db.Decimal(5, 2)
  serviceChargePercent Decimal @default(0) @db.Decimal(5, 2)
  minDeliveryCents  Int      @default(0)
  deliveryFeeCents  Int      @default(0)
  orderTypes        String[] @default(["DINE_IN", "TAKEAWAY"])
  acceptGuestOrders Boolean  @default(true)
  published         Boolean  @default(false)
  onlinePayments    Boolean  @default(false)
  loyaltyEnabled    Boolean  @default(true)
  loyaltyConfig     Json     @default("{}")
  bannerText        String   @default("")
  utcOffsetMinutes  Int      @default(330)
  openTime          String   @default("10:00")
  closeTime         String   @default("22:00")
  reservationSlotMinutes Int @default(90)
  orderCounter      Int      @default(0)
  createdAt         DateTime @default(now())
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  categories        Category[]
  products          Product[]
  tables            DiningTable[]
  customers         Customer[]
  orders            Order[]
  coupons           Coupon[]
  reservations      Reservation[]
  auditLogs         AuditLog[]
  payments          Payment[]
  suppliers         Supplier[]
  ingredients       Ingredient[]
  deliveryZones     DeliveryZone[]
  deliveryPartners  DeliveryPartner[]
  loyaltyTx         LoyaltyTransaction[]
  referrals         Referral[]
  campaigns         Campaign[]
  paymentAccounts   PaymentAccount[]

  @@index([tenantId])
  menuImages MenuImage[]
}

model Category {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  sort         Int        @default(0)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products     Product[]

  @@index([restaurantId])
}

model Product {
  id                 String     @id @default(cuid())
  restaurantId       String
  categoryId         String
  name               String
  description        String     @default("")
  priceCents         Int
  discountPriceCents Int?
  imageUrl           String?
  available          Boolean    @default(true)
  dietary            String[]   @default([])
  allergens          String[]   @default([])
  prepMinutes        Int        @default(15)
  sort               Int        @default(0)
  variants           Json       @default("[]")
  addons             Json       @default("[]")
  createdAt          DateTime   @default(now())
  restaurant         Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category           Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems         OrderItem[]
  recipe             RecipeItem[]

  @@index([restaurantId, categoryId])
}

model DiningTable {
  id           String        @id @default(cuid())
  restaurantId String
  label        String
  capacity     Int           @default(4)
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]
  reservations Reservation[]

  @@unique([restaurantId, label])
}

model Customer {
  id               String     @id @default(cuid())
  restaurantId     String
  name             String
  phone            String
  email            String?
  marketingConsent Boolean    @default(false)
  loyaltyPoints    Int        @default(0)
  lifetimePoints   Int        @default(0)
  birthday         DateTime?  @db.Date
  referralCode     String?
  unsubscribeToken String?    @unique
  optedOutAt       DateTime?
  createdAt        DateTime   @default(now())
  loyaltyTx        LoyaltyTransaction[]
  messages         CampaignMessage[]
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders           Order[]

  @@unique([restaurantId, phone])
  @@unique([restaurantId, referralCode])
}

model Order {
  id            String        @id @default(cuid())
  restaurantId  String
  number        Int
  trackingCode  String        @unique
  type          OrderType
  status        OrderStatus   @default(NEW)
  customerId    String?
  customerName  String
  customerPhone String
  tableId       String?
  address       String?
  notes         String?
  subtotalCents Int
  discountCents Int           @default(0)
  taxCents      Int
  serviceCents  Int           @default(0)
  deliveryCents Int           @default(0)
  tipCents      Int           @default(0)
  totalCents    Int
  couponCode    String?
  paymentMethod String        @default("CASH")
  paymentStatus PaymentStatus @default(UNPAID)
  createdAt     DateTime      @default(now())
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer      Customer?     @relation(fields: [customerId], references: [id])
  table         DiningTable?  @relation(fields: [tableId], references: [id])
  items         OrderItem[]
  history       OrderStatusHistory[]
  payments      Payment[]
  deliveryZoneId    String?
  deliveryPartnerId String?
  etaMinutes        Int?
  deliveryZone      DeliveryZone?    @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  deliveryPartner   DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id], onDelete: SetNull)

  @@unique([restaurantId, number])
  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
}

/// Photos uploaded for menu items. Kept in the database so backups, restores and several API servers all see the same files.
model MenuImage {
  id           String     @id @default(cuid())
  restaurantId String
  contentType  String
  data         Bytes
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String?
  name           String
  unitPriceCents Int
  quantity       Int
  options        Json    @default("[]")
  prepDone       Boolean @default(false)
  notes          String?
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  actorId   String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Coupon {
  id           String     @id @default(cuid())
  restaurantId String
  code         String
  type         CouponType
  value        Int
  minSubtotalCents Int    @default(0)
  active       Boolean    @default(true)
  expiresAt    DateTime?
  usageLimit   Int?
  usedCount    Int        @default(0)
  customerPhone String?
  categoryId   String?
  daysOfWeek   Int[]      @default([])
  startMinute  Int?
  endMinute    Int?
  source       String?
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, code])
  @@unique([restaurantId, customerPhone, source])
}

model Reservation {
  id           String            @id @default(cuid())
  restaurantId String
  tableId      String
  name         String
  phone        String
  partySize    Int
  startsAt     DateTime
  endsAt       DateTime
  status       ReservationStatus @default(CONFIRMED)
  notes        String?
  createdAt    DateTime          @default(now())
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table        DiningTable       @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([restaurantId, startsAt])
  @@index([tableId, startsAt])
}

model AuditLog {
  id           String      @id @default(cuid())
  restaurantId String?
  actorId      String?
  action       String
  detail       Json?
  createdAt    DateTime    @default(now())
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
}

model Payment {
  id                String           @id @default(cuid())
  restaurantId      String
  orderId           String
  provider          String
  providerRef       String?
  providerPaymentId String?
  checkoutUrl       String?
  accountId         String?
  amountCents       Int
  currency          String
  status            PayAttemptStatus @default(PENDING)
  createdAt         DateTime         @default(now())
  paidAt            DateTime?
  account           PaymentAccount?  @relation(fields: [accountId], references: [id])
  restaurant        Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds           Refund[]

  @@unique([provider, providerRef])
  @@index([orderId])
}

model Refund {
  id          String   @id @default(cuid())
  paymentId   String
  amountCents Int
  reason      String?
  providerRef String?
  actorId     String?
  createdAt   DateTime @default(now())
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model WebhookEvent {
  provider   String
  eventId    String
  receivedAt DateTime @default(now())

  @@id([provider, eventId])
}

enum StockReason {
  PURCHASE
  ADJUSTMENT
  WASTAGE
  ORDER
}

model Supplier {
  id           String       @id @default(cuid())
  restaurantId String
  name         String
  phone        String?
  email        String?
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  ingredients  Ingredient[]

  @@unique([restaurantId, name])
}

model Ingredient {
  id           String          @id @default(cuid())
  restaurantId String
  name         String
  unit         String
  stockQty     Decimal         @default(0) @db.Decimal(12, 3)
  lowThreshold Decimal         @default(0) @db.Decimal(12, 3)
  expiresAt    DateTime?
  supplierId   String?
  createdAt    DateTime        @default(now())
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  supplier     Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  recipes      RecipeItem[]
  movements    StockMovement[]

  @@unique([restaurantId, name])
}

model RecipeItem {
  id           String     @id @default(cuid())
  productId    String
  ingredientId String
  qty          Decimal    @db.Decimal(12, 3)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientId])
}

model StockMovement {
  id           String      @id @default(cuid())
  restaurantId String
  ingredientId String
  delta        Decimal     @db.Decimal(12, 3)
  reason       StockReason
  orderId      String?
  note         String?
  actorId      String?
  createdAt    DateTime    @default(now())
  ingredient   Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([orderId, ingredientId, reason])
  @@index([ingredientId, createdAt])
  @@index([restaurantId, createdAt])
}

model DeliveryZone {
  id               String     @id @default(cuid())
  restaurantId     String
  name             String
  feeCents         Int
  minOrderCents    Int        @default(0)
  etaMinutes       Int        @default(45)
  active           Boolean    @default(true)
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders           Order[]

  @@unique([restaurantId, name])
}

model DeliveryPartner {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  phone        String
  active       Boolean    @default(true)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@unique([restaurantId, name])
}

model LoyaltyTransaction {
  id           String        @id @default(cuid())
  restaurantId String
  customerId   String
  delta        Int
  reason       LoyaltyReason
  orderId      String?
  note         String?
  actorId      String?
  createdAt    DateTime      @default(now())
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([orderId, customerId, reason])
  @@index([customerId, createdAt])
}

model Referral {
  id           String         @id @default(cuid())
  restaurantId String
  referrerId   String
  referredId   String         @unique
  status       ReferralStatus @default(PENDING)
  createdAt    DateTime       @default(now())
  rewardedAt   DateTime?
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([referrerId])
}

model Campaign {
  id           String          @id @default(cuid())
  restaurantId String
  name         String
  channel      CampaignChannel
  segment      String
  subject      String?
  body         String
  couponCode   String?
  status       CampaignStatus  @default(DRAFT)
  createdAt    DateTime        @default(now())
  sentAt       DateTime?
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  messages     CampaignMessage[]

  @@index([restaurantId, createdAt])
}

model CampaignMessage {
  id          String        @id @default(cuid())
  campaignId  String
  customerId  String
  recipient   String
  status      MessageStatus @default(QUEUED)
  error       String?
  providerRef String?
  sentAt      DateTime?
  campaign    Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([campaignId, customerId])
  @@index([campaignId, status])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum InvoiceStatus {
  OPEN
  PAID
  VOID
}

enum InvoiceKind {
  NEW
  RENEWAL
  UPGRADE
}

model Plan {
  id             String         @id @default(cuid())
  code           String         @unique
  name           String
  description    String         @default("")
  priceCents     Int
  currency       String         @default("INR")
  intervalMonths Int            @default(1)
  trialDays      Int            @default(14)
  limits         Json           @default("{}")
  features       String[]       @default([])
  active         Boolean        @default(true)
  sort           Int            @default(0)
  subscriptions  Subscription[] @relation("plan")
  pending        Subscription[] @relation("pendingPlan")
  invoices       Invoice[]
}

model Subscription {
  id                 String             @id @default(cuid())
  tenantId           String             @unique
  planId             String
  status             SubscriptionStatus
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  pendingPlanId      String?
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan               Plan               @relation("plan", fields: [planId], references: [id])
  pendingPlan        Plan?              @relation("pendingPlan", fields: [pendingPlanId], references: [id])
  invoices           Invoice[]
}

model Invoice {
  id             String        @id @default(cuid())
  number         Int           @default(autoincrement())
  tenantId       String
  subscriptionId String
  planId         String
  kind           InvoiceKind
  amountCents    Int
  currency       String
  status         InvoiceStatus @default(OPEN)
  periodStart    DateTime
  periodEnd      DateTime
  dueAt          DateTime
  paidAt         DateTime?
  description    String
  createdAt      DateTime      @default(now())
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  plan           Plan          @relation(fields: [planId], references: [id])
  payments       SubscriptionPayment[]

  @@unique([subscriptionId, kind, periodStart])
  @@index([tenantId, createdAt])
}

model SubscriptionPayment {
  id                String           @id @default(cuid())
  invoiceId         String
  provider          String
  providerRef       String?
  providerPaymentId String?
  checkoutUrl       String?
  amountCents       Int
  currency          String
  status            PayAttemptStatus @default(PENDING)
  createdAt         DateTime         @default(now())
  paidAt            DateTime?
  invoice           Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([provider, providerRef])
  @@index([invoiceId])
}

/// A restaurant's own payment-provider credentials. Secrets are AES-256-GCM encrypted; they are never returned by the API.
/// Old accounts are kept (inactive) so refunds and late webhooks for payments they created still work.
model PaymentAccount {
  id           String     @id @default(cuid())
  restaurantId String
  provider     String
  secretsEnc   String
  keyHint      String
  mode         String     @default("test")
  webhookToken String     @unique
  active       Boolean    @default(true)
  verifiedAt   DateTime?
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@index([restaurantId, active])
}

enum AuthTokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFY
}

/// Single-use, expiring links sent by email. Only a SHA-256 hash is stored, so a database leak does not yield working links.
model AuthToken {
  id        String           @id @default(cuid())
  userId    String
  purpose   AuthTokenPurpose
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
}
