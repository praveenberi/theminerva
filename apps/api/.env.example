DATABASE_URL=postgresql://tablely:tablely@localhost:5433/tablely
JWT_SECRET=dev-only-change-me-please-32-chars-min
PORT=4000
WEB_ORIGIN=http://localhost:5173

# --- Online payments (set the ones you use; the server enables a provider only if ALL its vars are present) ---
# PAYMENT_PROVIDER=stripe            # which provider handles new checkouts: stripe | razorpay | test
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=             # webhook URL: <api>/api/payments/webhook/stripe  (events: checkout.session.completed, checkout.session.expired)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=           # webhook URL: <api>/api/payments/webhook/razorpay (events: payment_link.paid, .expired, .cancelled)
# ENABLE_TEST_PAYMENTS=1             # dev only: fake provider with a simulated payment page; ignored when NODE_ENV=production

# --- Marketing messages (a channel is enabled only when ALL of its variables are set) ---
# RESEND_API_KEY=                    # email via Resend (https://resend.com)
# EMAIL_FROM="Your Restaurant <offers@yourdomain.com>"   # must be a sender verified with Resend
# WHATSAPP_TOKEN=                    # WhatsApp Cloud API permanent token
# WHATSAPP_PHONE_ID=                 # WhatsApp phone-number id
# WHATSAPP_TEMPLATE=                 # approved marketing template with 2 body variables: {{1}} name, {{2}} message
# WHATSAPP_LANG=en
# PUBLIC_API_URL=https://api.yourdomain.com   # base URL used in the unsubscribe links inside messages
# ENABLE_TEST_MESSAGING=1            # dev only: records messages in memory instead of sending; ignored in production
# PUBLIC_WRITE_LIMIT=30              # per-IP per-minute limit on public order/booking/coupon requests

# --- Subscriptions ---
# DEFAULT_PLAN_CODE=GROWTH           # plan trialled when sign-up doesn't name one
# BILLING_GRACE_DAYS=7               # how long an unpaid invoice keeps the account working before it expires

# --- Restaurant payment accounts ---
# SECRETS_KEY=                        # 32+ random characters; encrypts restaurants' provider keys. REQUIRED in production, keep it backed up.
# PUBLIC_API_URL=https://api.yourdomain.com   # also forms the per-restaurant webhook URLs shown in Settings
# ALLOW_LIVE_PAYMENT_KEYS=1           # dev only: accept live keys outside production (don't)

# --- Security / deployment ---
# TRUST_PROXY=1                      # number of reverse proxies in front of the API (0 = none). Wrong values let clients fake their IP.
# API_RATE_LIMIT=600                 # requests per IP per minute across /api (webhooks and /health exempt)
# MAX_FAILED_LOGINS=8                # wrong passwords before an account is locked
# LOCK_MINUTES=15
# AUTH_CACHE_MS=10000                # how long a user's active/suspended state is cached per server
# REFRESH_REUSE_LEEWAY_MS=3000       # tolerance for two tabs refreshing at once before reuse is treated as theft
# ADMIN_EMAIL= / ADMIN_PASSWORD=     # production only: creates the first platform admin (password 14+ chars). Change it after first login.

# --- Account recovery and MFA ---
# (email delivery uses RESEND_API_KEY / EMAIL_FROM above; required in production)
# MFA_REQUIRE_ADMIN=1                # force MFA for the platform admin (default: on in production, off in development)
# REQUIRE_VERIFIED_EMAIL=1           # owners must confirm their email before sending campaigns or connecting payments (0 = off)
# AUTH_RATE_LIMIT=50                 # login / register / reset / MFA requests per IP per 15 minutes
# EXPORT_RATE_LIMIT=20               # report downloads (CSV/Excel/PDF) per user per minute
# MAIL_RATE_LIMIT=10                 # requests that send an email, per IP per hour
