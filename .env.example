NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/minerva?schema=public
JWT_ACCESS_SECRET=change-me-access-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-at-least-32-characters-long
WEB_ORIGIN=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173
# Optional integrations (leave blank = adapter reports "not configured")
REDIS_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
ANTHROPIC_API_KEY=
AWS_REGION=
S3_BUCKET=
CDN_URL=
# Image storage (free tier at cloudinary.com). When all three are set, uploads go to Cloudinary instead of local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# docker-compose only
POSTGRES_PASSWORD=change-me
# first-run owner account (db:seed)
SEED_OWNER_EMAIL=owner@yourdomain.com
SEED_OWNER_PASSWORD=ChangeMe-Long-Passw0rd
