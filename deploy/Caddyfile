# Public entry point: obtains and renews a Let's Encrypt certificate for $DOMAIN automatically and forwards to the web container.
# With DOMAIN=localhost Caddy uses its own local certificate authority (browsers will warn), which is what you want for a dry run.
{
	http_port {$HTTP_PORT:80}
	https_port {$HTTPS_PORT:443}
}

{$DOMAIN:localhost} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy web:8080
}
