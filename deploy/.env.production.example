# Copy to .env.production (repository root) and fill in. NEVER commit the filled-in file.
# Generate secrets with:  openssl rand -hex 32   (use `openssl rand -base64 48` for JWT_SECRET)

# ---- Where the app lives -------------------------------------------------------------
DOMAIN=app.example.com                  # DNS A/AAAA record must point at this server; Caddy gets a certificate for it
WEB_ORIGIN=https://app.example.com      # exactly what users type in the browser
PUBLIC_API_URL=https://app.example.com  # same domain: nginx forwards /api to the API. Used in email links and webhook URLs
HTTP_PORT=80
HTTPS_PORT=443
TRUST_PROXY=2                           # proxies in front of the API (Caddy + nginx). Wrong value = spoofable client IPs

# ---- Database (only reachable inside the compose network) ------------------------------
POSTGRES_USER=tablely
POSTGRES_PASSWORD=                      # openssl rand -hex 24  (keep it URL-safe: hex only)
POSTGRES_DB=tablely

# ---- Secrets: back these up SEPARATELY from the database -------------------------------
JWT_SECRET=                             # >= 48 random characters
SECRETS_KEY=                            # >= 32 random characters. Encrypts restaurants' payment keys. Lose it = they must re-enter keys

# ---- Email (required: password reset and email confirmation cannot work without it) ----
RESEND_API_KEY=
EMAIL_FROM="The Minerva <no-reply@example.com>"   # a sender verified with Resend; set SPF, DKIM and DMARC for the domain

# ---- Platform payment account (only for charging subscriptions; restaurants add their own in Settings) ----
PAYMENT_PROVIDER=                       # stripe | razorpay | empty
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=                  # platform webhook: https://<DOMAIN>/api/payments/webhook/stripe
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Optional ---------------------------------------------------------------------------
DEFAULT_PLAN_CODE=GROWTH
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=

# ---- Images (CI pushes these; leave unset to build locally) -----------------------------
# API_IMAGE=ghcr.io/your-org/theminerva-api:latest
# WEB_IMAGE=ghcr.io/your-org/theminerva-web:latest
